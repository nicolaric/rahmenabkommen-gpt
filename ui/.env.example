# Public URL of this app (used for share links and meta tags)
VITE_FRONTEND_URL=https://rahmenabkommen-gpt.ch
# Browser code reaches yeos only through the same-origin proxy route (not under /api,
# which nginx routes to the Flask API)
VITE_API_URL=/yeos
# yeos organization the public chat runs in (also baked into the client)
VITE_YEOS_ORGANIZATION_ID=

# Server-only — never exposed to the browser
EOS_API_URL=https://cloud.yeos.ai/api
EOS_API_SERVICE_KEY=
YEOS_ORGANIZATION_ID=
YEOS_WORKSPACE_ID=
# Flask API in ../api (shares, feed, stats); token must match api/.env
BACKEND_URL=http://localhost:8000
INTERNAL_API_TOKEN=
# Signs the theme cookie
SESSION_SECRET=
